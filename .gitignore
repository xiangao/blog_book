.quarto/
/.quarto/
**/*.quarto_ipynb

# Root-level knitr cache and rendered-figure dirs (per-chapter scratch).
# Scope to root only so figure dirs inside _book/ are still tracked.
/*_cache/
/*_files/

# Root-level scratch html files (legacy from migration).
/*.html

convert_posts.py

# knitr chunk caches (local only; NOT needed for deploy — _freeze/ is)
*_cache/

.Rhistory

# Root-level LaTeX byproducts from a book PDF render (index.tex is 1.3 MB).
/index.aux
/index.log
/index.tex
/index.toc

# Stata engine scratch. Stata auto-runs any profile.do in the working dir,
# so a stray one here would execute on every future Stata session.
/profile.do
